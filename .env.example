# Copy to .env (local) or set these in Vercel -> Settings -> Environment Variables.

# Database (MongoDB Atlas): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGO_URL=
DB_NAME=yababerma

# Admin panel key (do not rely on the built-in default)
ADMIN_KEY=
ADMIN_EMAIL=

# Public site URL, used in emails
NEXT_PUBLIC_BASE_URL=https://www.yababerma.org

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, "Web application")
#   Authorized redirect URIs:
#     https://www.yababerma.org/api/auth/google/callback
#     http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Resend email, Fonnte WhatsApp
RESEND_API_KEY=
MAIL_FROM=
FONNTE_TOKEN=

# Midtrans (donasi otomatis: QRIS, e-wallet, Virtual Account). Dashboard Midtrans -> Settings -> Access Keys.
#   Sandbox keys start with "SB-" (testing); production keys switch to real payments. Use a matching pair.
#   Payment Notification URL (dashboard -> Settings -> Payment): https://www.yababerma.org/api/payments/midtrans/notification
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
